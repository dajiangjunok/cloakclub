# Aleo public testnet configuration. Never put an Aleo private key here.
NEXT_PUBLIC_ALEO_PROGRAM_ID=
NEXT_PUBLIC_ALEO_API_URL=https://api.explorer.provable.com/v1
NEXT_PUBLIC_ALEO_EXPLORER_URL=https://testnet.aleo.info
NEXT_PUBLIC_ALEO_TX_FEE=0.1

# The field literals used to initialize the deployed program.
NEXT_PUBLIC_COMMUNITY_ID=
NEXT_PUBLIC_PROPOSAL_ID=

# Public browser credentials from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
